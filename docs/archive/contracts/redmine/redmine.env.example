# Kopiér til redmine.env og udfyld (redmine.env er gitignored hvis I tilføjer den)
REDMINE_URL=https://redmine.jeresdomæne.dk
REDMINE_API_KEY=
REDMINE_PROJECT=eira-os

# Custom field IDs — find under Administration → Custom fields → Issues
# Klik rediger på feltet; id står i URL: .../custom_fields/5/edit
REDMINE_CF_CONTRACT_ID=
REDMINE_CF_OWNER=
REDMINE_CF_PROMPT_PATH=
REDMINE_CF_CONTRACT_STATUS=
REDMINE_CF_DEPENDS_ON=
