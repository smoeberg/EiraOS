# EIRA phase1 — copy to .env and fill in for live Entra OIDC

# Mock login (default when OIDC_CLIENT_ID is unset)
EIRA_OIDC_MOCK=true

# Live Entra ID (set EIRA_OIDC_MOCK=false when configured)
OIDC_TENANT_ID=your-tenant-guid
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8765/v1/auth/oidc/callback
OIDC_UI_REDIRECT_URI=http://localhost:5173/
OIDC_SCOPES=openid profile email
# Optional — auto-derived from tenant when unset
# OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
