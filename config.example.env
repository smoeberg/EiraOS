# EIRA — copy to .env (development) or /etc/eira/eira.conf (installed).
# Identity: any OpenID Connect provider (specs/EIRA-IDENTITY-1.0.md).
# EiraOS has no built-in provider (ADR-0004 D1).

# Mock login (development only; refused when EIRA_ENV=production)
EIRA_OIDC_MOCK=true

# --- Live OIDC (set EIRA_OIDC_MOCK=false when configured) -------------------
# Installation-chosen provider id: first part of every identity,
# did:eira:<provider-id>.<subject>. Never change it once users have logged in.
OIDC_PROVIDER_ID=
OIDC_PROVIDER_NAME=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8765/v1/auth/oidc/callback
OIDC_UI_REDIRECT_URI=http://localhost:5173/
OIDC_SCOPES=openid profile email
# OIDC_SUBJECT_CLAIM=sub
# OIDC_SUBJECT_CASE_INSENSITIVE=false
# OIDC_GROUPS_CLAIM=groups
# OIDC_ORG_CLAIM=
# Endpoints come from {issuer}/.well-known/openid-configuration unless set:
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_JWKS_URI=

# --- Example: Keycloak --------------------------------------------------------
# OIDC_PROVIDER_ID=keycloak
# OIDC_PROVIDER_NAME=Kommunens login
# OIDC_ISSUER=https://login.kommune.example/realms/staff

# --- Example: Microsoft Entra (keeps existing did:eira:entra.<oid> identities)
# OIDC_PROVIDER_ID=entra
# OIDC_PROVIDER_NAME=Microsoft
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_SUBJECT_CLAIM=oid
# OIDC_SUBJECT_CASE_INSENSITIVE=true
# OIDC_ORG_CLAIM=tid
