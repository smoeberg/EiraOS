{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eira-os/specs/eira-rights-set-1.0.schema.json",
  "title": "EIRA Rights Set 1.0",
  "description": "Normative structure of a rights set (specs/EIRA-RIGHTS-SET-1.0.md §2). Byte-level rules (UTF-8, NFC, no duplicate keys, <= 1 MiB) and all semantic checks live in app/rights/contract.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eira_rights", "rights_set_id", "kind", "tenant_id", "device_id", "version",
               "issued_at", "expires_at", "template", "issued_by", "grants", "denies", "signature"],
  "properties": {
    "eira_rights": {"const": "1"},
    "rights_set_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "kind": {"enum": ["managed", "default"]},
    "tenant_id": {"$ref": "#/$defs/id"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "issued_at": {"$ref": "#/$defs/time"},
    "expires_at": {"$ref": "#/$defs/time"},
    "template": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1, "maxLength": 32}}
    },
    "issued_by": {
      "type": "object", "additionalProperties": false, "required": ["api_call_id", "fleet"],
      "properties": {
        "api_call_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "fleet": {"type": "string", "minLength": 1, "maxLength": 253}
      }
    },
    "grants": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/grant"}},
    "denies": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/deny"}},
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": {"const": "ed25519"},
        "key_id": {"$ref": "#/$defs/id"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "default"}}},
      "then": {"properties": {"tenant_id": {"const": "unmanaged"}, "device_id": {"const": "*"}}},
      "else": {"properties": {"tenant_id": {"not": {"const": "unmanaged"}}, "device_id": {"not": {"const": "*"}}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "subject": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["group"], "properties": {"group": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["principal"], "properties": {"principal": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["authenticated"], "properties": {"authenticated": {"const": true}}}
      ]
    },
    "scope": {"type": "string", "pattern": "^(device:local|obj:[a-z][a-z0-9_]{0,31}:(\\*|[A-Za-z0-9][A-Za-z0-9._-]{0,127}))$"},
    "actions": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(edp:[a-z][a-z0-9_]{0,63}|system:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+)$"}
    },
    "grant": {
      "type": "object", "additionalProperties": false, "required": ["subject", "scope", "actions"],
      "properties": {
        "subject": {"$ref": "#/$defs/subject"},
        "scope": {"$ref": "#/$defs/scope"},
        "actions": {"$ref": "#/$defs/actions"},
        "expires_at": {"$ref": "#/$defs/time"},
        "required_assurance": {"enum": ["eid_low", "eid_high"]}
      }
    },
    "deny": {
      "type": "object", "additionalProperties": false, "required": ["subject", "scope", "actions"],
      "properties": {
        "subject": {"$ref": "#/$defs/subject"},
        "scope": {"$ref": "#/$defs/scope"},
        "actions": {"$ref": "#/$defs/actions"},
        "expires_at": {"$ref": "#/$defs/time"}
      }
    }
  }
}
