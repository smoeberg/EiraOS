@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_TRUSTED_H
+#define LABWC_TRUSTED_H
+
+#include <stdbool.h>
+#include <sys/types.h>
+
+struct seat;
+struct view;
+struct wl_client;
+struct wlr_surface;
+
+/*
+ * Trusted group (<core><trustedGroup>): windows of clients whose effective
+ * GID at connect() is that group are stacked above every other window,
+ * layer, popup, drag icon and menu, and hold keyboard focus while they are
+ * shown. Meanwhile no other client can take focus, start a drag, keep an
+ * input grab or set a cursor image. Only the session lock is above them.
+ *
+ * Meant for a setgid consent dialog: the group has no members, so only a
+ * program installed setgid to it is trusted. See labwc-config(5).
+ */
+
+/* Creates the scene trees. Call once, after the other server trees. */
+void trusted_init(void);
+void trusted_finish(void);
+
+/* False for a group labwc itself is in (it would trust every client). */
+bool trusted_gid_acceptable(gid_t gid);
+
+bool trusted_client(struct wl_client *client);
+bool trusted_surface(struct wlr_surface *surface);
+
+/* A mapped view of a trusted client, or NULL. */
+struct view *trusted_active_view(void);
+
+/* Parent for a new xdg toplevel: the trusted tree for trusted clients. */
+struct wlr_scene_tree *trusted_view_parent(struct view *view,
+	struct wlr_scene_tree *fallback);
+struct wlr_scene_tree *trusted_popup_parent(struct view *view,
+	struct wlr_scene_tree *fallback);
+
+/* Keep the trusted tree above everything but the session lock. */
+void trusted_restack(void);
+
+/* A trusted view was mapped: focus it and drop input others hold. */
+void trusted_view_mapped(struct view *view);
+
+/* True if focusing @view must be refused (a trusted view is shown). */
+bool trusted_blocks_view(struct view *view);
+
+/* Cursor image from @client must be refused (a trusted view is shown). */
+bool trusted_blocks_cursor(struct wl_client *client);
+
+#endif /* LABWC_TRUSTED_H */
