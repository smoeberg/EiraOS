diff --git a/src/trusted.c b/src/trusted.c
new file mode 100644
index 000000000000..5a1553a83c6a
--- /dev/null
+++ b/src/trusted.c
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Trusted group: see include/trusted.h and labwc-config(5).
+ *
+ * The client's GID comes from wl_client_get_credentials(), i.e. SO_PEERCRED
+ * on the client's socket, which the kernel records at connect(). For a
+ * setgid program it is the effective GID, which a process running as the
+ * user cannot obtain for itself.
+ */
+#define _POSIX_C_SOURCE 200809L
+#include "trusted.h"
+#include <assert.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <wayland-server-core.h>
+#include <wlr/types/wlr_compositor.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/types/wlr_seat.h>
+#include <wlr/util/log.h>
+#include "common/scene-helpers.h"
+#include "config/rcxml.h"
+#include "input/cursor.h"
+#include "labwc.h"
+#include "output.h"
+#include "view.h"
+
+static struct {
+	struct wl_listener keyboard_grab_begin;
+	struct wl_listener pointer_grab_begin;
+	struct wl_listener touch_grab_begin;
+	struct wl_event_source *end_grabs;
+} trusted;
+
+bool
+trusted_gid_acceptable(gid_t gid)
+{
+	if (gid == getgid() || gid == getegid()) {
+		return false;
+	}
+	int n = getgroups(0, NULL);
+	if (n < 0) {
+		return false;
+	}
+	gid_t *groups = calloc((size_t)n + 1, sizeof(*groups));
+	if (!groups) {
+		return false;
+	}
+	n = getgroups(n, groups);
+	bool member = n < 0;
+	for (int i = 0; i < n; i++) {
+		if (groups[i] == gid) {
+			member = true;
+		}
+	}
+	free(groups);
+	return !member;
+}
+
+bool
+trusted_client(struct wl_client *client)
+{
+	if (!client || !rc.trusted_group_valid) {
+		return false;
+	}
+	pid_t pid;
+	uid_t uid;
+	gid_t gid;
+	wl_client_get_credentials(client, &pid, &uid, &gid);
+	return gid == rc.trusted_gid;
+}
+
+bool
+trusted_surface(struct wlr_surface *surface)
+{
+	return surface && surface->resource
+		&& trusted_client(wl_resource_get_client(surface->resource));
+}
+
+struct view *
+trusted_active_view(void)
+{
+	struct view *view;
+	wl_list_for_each(view, &server.views, link) {
+		if (view->trusted && view->mapped && view->surface) {
+			return view;
+		}
+	}
+	return NULL;
+}
+
+bool
+trusted_blocks_view(struct view *view)
+{
+	return !view->trusted && trusted_active_view();
+}
+
+bool
+trusted_blocks_cursor(struct wl_client *client)
+{
+	return !trusted_client(client) && trusted_active_view();
+}
+
+struct wlr_scene_tree *
+trusted_view_parent(struct view *view, struct wlr_scene_tree *fallback)
+{
+	return view->trusted ? server.trusted_view_tree : fallback;
+}
+
+struct wlr_scene_tree *
+trusted_popup_parent(struct view *view, struct wlr_scene_tree *fallback)
+{
+	return view && view->trusted ? server.trusted_popup_tree : fallback;
+}
+
+void
+trusted_restack(void)
+{
+	if (!server.trusted_tree) {
+		return;
+	}
+	wlr_scene_node_raise_to_top(&server.trusted_tree->node);
+	struct output *output;
+	wl_list_for_each(output, &server.outputs, link) {
+		if (output->session_lock_tree) {
+			wlr_scene_node_raise_to_top(
+				&output->session_lock_tree->node);
+		}
+	}
+}
+
+static void
+end_grabs(void *data)
+{
+	trusted.end_grabs = NULL;
+	if (!trusted_active_view()) {
+		return;
+	}
+	struct wlr_seat *seat = server.seat.wlr_seat;
+	if (wlr_seat_keyboard_has_grab(seat)) {
+		wlr_log(WLR_INFO, "trusted window shown: ending keyboard grab");
+		wlr_seat_keyboard_end_grab(seat);
+	}
+	if (wlr_seat_pointer_has_grab(seat)) {
+		wlr_log(WLR_INFO, "trusted window shown: ending pointer grab");
+		wlr_seat_pointer_end_grab(seat);
+	}
+	if (wlr_seat_touch_has_grab(seat)) {
+		wlr_log(WLR_INFO, "trusted window shown: ending touch grab");
+		wlr_seat_touch_end_grab(seat);
+	}
+}
+
+/*
+ * A grab started while a trusted window is shown (an xdg_popup grab with an
+ * old serial, say) would route input past keyboard focus. It is ended from
+ * an idle callback, outside the wlroots request that started it.
+ */
+static void
+handle_grab_begin(struct wl_listener *listener, void *data)
+{
+	if (trusted.end_grabs || !trusted_active_view()) {
+		return;
+	}
+	trusted.end_grabs = wl_event_loop_add_idle(server.wl_event_loop,
+		end_grabs, NULL);
+}
+
+void
+trusted_view_mapped(struct view *view)
+{
+	assert(view->trusted);
+	trusted_restack();
+
+	struct seat *seat = &server.seat;
+	end_grabs(NULL);
+
+	/* A client cursor image is drawn above every scene node. */
+	struct wlr_seat_client *pointer_client =
+		seat->wlr_seat->pointer_state.focused_client;
+	if (pointer_client && !trusted_client(pointer_client->client)) {
+		seat->server_cursor = LAB_CURSOR_CLIENT;
+		cursor_set(seat, LAB_CURSOR_DEFAULT);
+	}
+
+	wlr_log(WLR_INFO, "trusted window mapped (app_id=%s)",
+		view->app_id ? view->app_id : "");
+}
+
+void
+trusted_init(void)
+{
+	server.trusted_tree = lab_wlr_scene_tree_create(&server.scene->tree);
+	server.trusted_view_tree = lab_wlr_scene_tree_create(server.trusted_tree);
+	server.trusted_popup_tree = lab_wlr_scene_tree_create(server.trusted_tree);
+	trusted_restack();
+
+	struct wlr_seat *seat = server.seat.wlr_seat;
+	trusted.keyboard_grab_begin.notify = handle_grab_begin;
+	wl_signal_add(&seat->events.keyboard_grab_begin, &trusted.keyboard_grab_begin);
+	trusted.pointer_grab_begin.notify = handle_grab_begin;
+	wl_signal_add(&seat->events.pointer_grab_begin, &trusted.pointer_grab_begin);
+	trusted.touch_grab_begin.notify = handle_grab_begin;
+	wl_signal_add(&seat->events.touch_grab_begin, &trusted.touch_grab_begin);
+}
+
+void
+trusted_finish(void)
+{
+	if (trusted.end_grabs) {
+		wl_event_source_remove(trusted.end_grabs);
+		trusted.end_grabs = NULL;
+	}
+	if (trusted.keyboard_grab_begin.link.next) {
+		wl_list_remove(&trusted.keyboard_grab_begin.link);
+		wl_list_remove(&trusted.pointer_grab_begin.link);
+		wl_list_remove(&trusted.touch_grab_begin.link);
+	}
+}
