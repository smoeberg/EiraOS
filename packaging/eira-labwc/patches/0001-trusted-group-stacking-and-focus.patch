+/*
+ * <core><trustedGroup>: fails closed. A group that does not exist, or that
+ * labwc itself is in (so every client would have it), trusts no window.
+ */
+static void
+set_trusted_group(const char *name)
+{
+	rc.trusted_group_valid = false;
+	struct group *group = getgrnam(name);
+	if (!group) {
+		wlr_log(WLR_ERROR, "trustedGroup '%s' does not exist; "
+			"no window is trusted", name);
+		return;
+	}
+	if (!trusted_gid_acceptable(group->gr_gid)) {
+		wlr_log(WLR_ERROR, "trustedGroup '%s' is a group labwc runs in; "
+			"no window is trusted", name);
+		return;
+	}
+	rc.trusted_gid = group->gr_gid;
+	rc.trusted_group_valid = true;
+}
