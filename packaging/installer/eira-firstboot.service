[Unit]
Description=EiraOS first boot: bind installer user to the EiraOS session
Documentation=https://github.com/smoeberg/EiraOS
After=cloud-final.service systemd-user-sessions.service
Wants=cloud-final.service
ConditionPathExists=!/var/lib/eira/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/lib/eira/eira-firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
