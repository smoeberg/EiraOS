[Unit]
Description=EiraOS first boot: make EiraOS the default session for the installer user
Documentation=https://github.com/smoeberg/EiraOS
After=cloud-config.service systemd-user-sessions.service accounts-daemon.service
Before=display-manager.service gdm.service
ConditionPathExists=!/var/lib/eira/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/lib/eira/eira-firstboot
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
