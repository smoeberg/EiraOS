# AT_SECURE: the loader ignores LD_DEBUG (and LD_PRELOAD) for the setgid
# agent, but not for a plain copy (the control shows the test can see it).
consent_agent_secure() {
    cp "$AGENT" /tmp/agent-plain && chmod 0755 /tmp/agent-plain
    control=$(runuser -u "$USER_NAME" -- env LD_DEBUG=libs /tmp/agent-plain --version 2>&1 | grep -c "calling init")
    agent=$(runuser -u "$USER_NAME" -- env LD_DEBUG=libs "$AGENT" --version 2>&1 | grep -c "calling init")
    rm -f /tmp/agent-plain
    say "diag consent-agent-ld-debug: control=$control agent=$agent"
    [ "$control" -gt 0 ] && [ "$agent" -eq 0 ]
}
