# EIRA Delegation Protocol v1.1: nothing but the app (with the session's
# consent key) can create a delegation; a forged request is refused.
check delegation-needs-trusted-path python3 - <<'PY'
import json, socket
token = ""
for line in open("/etc/eira/eira.conf", encoding="utf-8"):
    if line.startswith("EIRA_IPC_TOKEN="):
        token = line.split("=", 1)[1].strip()
# propose: a forged session is refused (-32003). proposal/create: only the
# consent agent may decide, refused before the session is looked at
# (EIRA-CONSENT-AGENT §5.4a: -32004 E_CONSENT_PATH).
for method, params, code, message in (
    ("delegation.propose", {"session_id": "forged", "delegee_id": "model:x", "scope": {"actions": ["prepare"]}},
     -32003, None),
    ("delegation.proposal", {"session_id": "forged", "proposal_id": "p"}, -32004, "E_CONSENT_PATH"),
    ("delegation.create", {"session_id": "forged", "proposal_id": "p", "content_hash": "c",
                           "rendering_hash": "r", "proof": "0" * 64}, -32004, "E_CONSENT_PATH"),
):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(5)
    s.connect("/run/eira/delegationd.sock")
    s.sendall((json.dumps({"jsonrpc": "2.0", "id": 1, "method": method,
                           "params": {**params, "_eira": {"ipc_token": token}}}) + "\n").encode())
    reply = json.loads(s.makefile().readline())
    error = reply.get("error", {})
    assert error.get("code") == code, (method, reply)
    assert message is None or error.get("message") == message, (method, reply)
PY
