#!/bin/sh
# CI-only boot acceptance check for the installed EiraOS system.
#
# Prints one "EIRA-CI <check> PASS|FAIL" line per check and a final
# "EIRA-CI RESULT PASS|FAIL" to the serial console (/dev/ttyS0), which the CI
# job reads from QEMU's serial log. Then powers the VM off.
set -u

OUT=${EIRA_CI_OUT:-/dev/ttyS0}
USER_NAME=tester
DAEMONS="stated identityd fleetd veritasd intentd graphd"
failed=0

say() { echo "EIRA-CI $*" > "$OUT" 2>/dev/null || echo "EIRA-CI $*"; }
check() {
    name=$1
    shift
    if "$@" >/dev/null 2>&1; then
        say "$name PASS"
    else
        say "$name FAIL"
        failed=1
    fi
}
wait_for() {
    seconds=$1
    shift
    while [ "$seconds" -gt 0 ]; do
        "$@" >/dev/null 2>&1 && return 0
        sleep 5
        seconds=$((seconds - 5))
    done
    return 1
}

say "BEGIN $(. /etc/os-release && echo "$PRETTY_NAME") uptime=$(cut -d' ' -f1 /proc/uptime)s"
check eira.target wait_for 300 systemctl is-active --quiet eira.target
for daemon in $DAEMONS; do
    check "daemon-$daemon" systemctl is-active --quiet "eira-$daemon.service"
    check "socket-$daemon" test -S "/run/eira/$daemon.sock"
done
check stated-ipc-health python3 - <<'PY'
import json, socket
token = ""
for line in open("/etc/eira/eira.conf", encoding="utf-8"):
    if line.startswith("EIRA_IPC_TOKEN="):
        token = line.split("=", 1)[1].strip()
s = socket.socket(socket.AF_UNIX)
s.settimeout(5)
s.connect("/run/eira/stated.sock")
s.sendall((json.dumps({"jsonrpc": "2.0", "id": 1, "method": "health",
                       "params": {"_eira": {"ipc_token": token}}}) + "\n").encode())
reply = json.loads(s.makefile().readline())
assert reply["result"]["ok"] is True, reply
PY
# Gate Kernel is loaded in intentd and can write its audit: a malformed
# proposal must come back as an explicit REJECT (E_SYNTAX), never execute.
check gate-ipc-reject python3 - <<'PY'
import json, socket
token = ""
for line in open("/etc/eira/eira.conf", encoding="utf-8"):
    if line.startswith("EIRA_IPC_TOKEN="):
        token = line.split("=", 1)[1].strip()
s = socket.socket(socket.AF_UNIX)
s.settimeout(5)
s.connect("/run/eira/intentd.sock")
s.sendall((json.dumps({"jsonrpc": "2.0", "id": 1, "method": "gate.propose",
                       "params": {"edp": "{", "_eira": {"ipc_token": token}}}) + "\n").encode())
reply = json.loads(s.makefile().readline())
result = reply["result"]
assert result["decision"] == "REJECT" and result["error"] == "E_SYNTAX", reply
PY
# Gate 1.1 power executor on the installed system: AppArmor lets intentd run
# busctl, polkit grants the eira user the login1 power actions, and logind
# answers "yes". Read-only (CanPowerOff etc.); nothing is shut down.
check gate-power-capability python3 - <<'PY'
import json, socket
token = ""
for line in open("/etc/eira/eira.conf", encoding="utf-8"):
    if line.startswith("EIRA_IPC_TOKEN="):
        token = line.split("=", 1)[1].strip()
s = socket.socket(socket.AF_UNIX)
s.settimeout(30)
s.connect("/run/eira/intentd.sock")
s.sendall((json.dumps({"jsonrpc": "2.0", "id": 1, "method": "gate.capabilities",
                       "params": {"_eira": {"ipc_token": token}}}) + "\n").encode())
reply = json.loads(s.makefile().readline())
power = reply["result"]["power"]
print("gate power capability:", power)
assert power["poweroff"] == "yes" and power["reboot"] == "yes", reply
PY
# EIRA-RIGHTS-SET-1.0 §5: an unmanaged install runs the bundle's signed
# default set, and the gate says it is a private machine (owner_admin).
check rights-default-active python3 - <<'PY'
import json, socket
token = ""
for line in open("/etc/eira/eira.conf", encoding="utf-8"):
    if line.startswith("EIRA_IPC_TOKEN="):
        token = line.split("=", 1)[1].strip()
s = socket.socket(socket.AF_UNIX)
s.settimeout(30)
s.connect("/run/eira/intentd.sock")
s.sendall((json.dumps({"jsonrpc": "2.0", "id": 1, "method": "gate.capabilities",
                       "params": {"_eira": {"ipc_token": token}}}) + "\n").encode())
rights = json.loads(s.makefile().readline())["result"]["rights"]
print("gate rights:", rights)
assert rights["state"] == "active", rights
assert rights["rights_kind"] == "default" and rights["owner_admin"] is True, rights
assert rights["clock_rollback"] is False, rights
PY
# GATE-KERNEL bilag A pkt. 1: the model has its own uid, reaches the gate,
# never owns Eira data, and over the real socket it can propose but the gate
# refuses its consent.
check model-user-exists getent passwd eira-model
check model-in-eira-clients sh -c "id -nG eira-model | tr ' ' '\n' | grep -qx eira-clients"
check model-not-in-eira sh -c "! id -nG eira-model | tr ' ' '\n' | grep -qx eira"
check model-is-system-uid sh -c '[ "$(id -u eira-model)" -lt 1000 ] && [ "$(id -u eira-model)" -ne "$(id -u eira)" ]'
check model-cannot-consent runuser -u eira-model -- python3 - <<'PY'
import json, socket
token = ""
for line in open("/etc/eira/eira.conf", encoding="utf-8"):
    if line.startswith("EIRA_IPC_TOKEN="):
        token = line.split("=", 1)[1].strip()
s = socket.socket(socket.AF_UNIX)
s.settimeout(30)
s.connect("/run/eira/intentd.sock")
s.sendall((json.dumps({"jsonrpc": "2.0", "id": 1, "method": "gate.consent",
                       "params": {"action_id": "x", "content_hash": "sha256:" + "0" * 64,
                                  "rendering_hash": "sha256:" + "0" * 64, "session_id": "s",
                                  "_peer": {"uid": 1000},
                                  "_eira": {"ipc_token": token}}}) + "\n").encode())
reply = json.loads(s.makefile().readline())["result"]
print("model consent:", reply)
assert reply["decision"] == "REJECT" and "only the user" in reply["detail"], reply
PY
# FLEET-RIGHTS-API §7: the sync timer is armed, its AppArmor profile is
# loaded, and on a private machine a round ends as "not enrolled" (exit 2).
check rights-sync-timer-enabled systemctl is-enabled --quiet eira-rights-sync.timer
check rights-sync-profile-loaded sh -c "grep -q '^/usr/bin/eira-rights-apply ' /sys/kernel/security/apparmor/profiles"
check rights-sync-not-enrolled sh -c 'runuser -u eira -- env EIRA_RIGHTS_DIR=/data/rights /usr/bin/eira-rights-apply sync; [ $? -eq 2 ]'
check enroll-tool-installed test -x /usr/bin/eira-enroll
# The desktop user can read neither the cache nor change it.
check user-cannot-touch-rights-cache sh -c "! runuser -u $USER_NAME -- test -r /data/rights/active.json && ! runuser -u $USER_NAME -- test -w /data/rights"
check wayland-session-file test -f /usr/share/wayland-sessions/eira-session.desktop
# Explorer has no escape hatch: EiraOS is the only selectable session.
check only-eira-session sh -c '[ "$(ls /usr/share/wayland-sessions /usr/share/xsessions 2>/dev/null | grep "\.desktop$")" = "eira-session.desktop" ]'
check gnome-session-hidden sh -c '! ls /usr/share/wayland-sessions/ubuntu*.desktop >/dev/null 2>&1'
check session-policy-active systemctl is-active --quiet eira-session-policy.service
check firstboot-done test -e /var/lib/eira/firstboot.done
check default-session grep -q '^Session=eira-session$' "/var/lib/AccountsService/users/$USER_NAME"
check user-in-eira-clients sh -c "id -nG $USER_NAME | tr ' ' '\\n' | grep -qx eira-clients"
# ADR-0003: the desktop user reaches the daemons but cannot touch their state.
check user-not-in-eira sh -c "! id -nG $USER_NAME | tr ' ' '\\n' | grep -qx eira"
check user-cannot-write-gate-db sh -c "test -e /data/eira-app.db && ! runuser -u $USER_NAME -- test -w /data/eira-app.db && ! runuser -u $USER_NAME -- test -r /data/eira-app.db"
# A full round-trip: connect() proves the socket's group/mode, the reply proves
# the daemon's peer-credential check accepts the user via eira-clients.
REACH_PY='import json, socket
token = ""
for line in open("/etc/eira/eira.conf", encoding="utf-8"):
    if line.startswith("EIRA_IPC_TOKEN="):
        token = line.split("=", 1)[1].strip()
s = socket.socket(socket.AF_UNIX)
s.settimeout(10)
s.connect("/run/eira/intentd.sock")
s.sendall((json.dumps({"jsonrpc": "2.0", "id": 1, "method": "health",
                       "params": {"_eira": {"ipc_token": token}}}) + "\n").encode())
reply = json.loads(s.makefile().readline())
assert reply["result"]["ok"] is True, reply'
check user-can-reach-intentd runuser -u "$USER_NAME" -- python3 -c "$REACH_PY"
if [ "$failed" -ne 0 ]; then
    say "diag run-eira: $(ls -ln /run/eira 2>&1 | tr '\n' ' ')"
    say "diag user-ids: $(id "$USER_NAME" 2>&1)"
    say "diag reach: $(runuser -u "$USER_NAME" -- python3 -c "$REACH_PY" 2>&1 | tail -n 2 | tr '\n' ' ')"
    say "diag intentd-log: $(journalctl -u eira-intentd.service -b --no-pager -n 15 2>&1 | tr '\n' ' ' | cut -c1-1500)"
    say "diag apparmor: $(journalctl -k -b --no-pager 2>&1 | grep -i 'apparmor=\"DENIED\"' | tail -n 5 | tr '\n' ' ' | cut -c1-1500)"
fi
check login-screen wait_for 300 systemctl is-active --quiet display-manager.service
check labwc-running wait_for 600 pgrep -u "$USER_NAME" -x labwc
check eira-shell-running wait_for 180 pgrep -u "$USER_NAME" -f eira-spatial-desktop

if [ "$failed" -ne 0 ]; then
    {
        echo "---- systemctl --failed"
        systemctl --failed --no-pager
        echo "---- pending jobs"
        systemctl list-jobs --no-pager
        echo "---- sessions"
        loginctl list-sessions --no-pager
        ps -eo user,pid,cmd | grep -E "labwc|eira-|gdm-wayland|gnome-session" | grep -v grep
        echo "---- journal (eira, gdm, labwc)"
        journalctl -b --no-pager -n 300 -u 'eira-*' -u gdm.service
        journalctl -b --no-pager -n 150 _COMM=labwc _COMM=eira-spatial-de _COMM=eira-session
        echo "---- user journal ($USER_NAME)"
        journalctl -b --no-pager -n 120 _UID="$(id -u "$USER_NAME")"
    } > "$OUT" 2>&1
fi

if [ "$failed" -eq 0 ]; then say "RESULT PASS"; else say "RESULT FAIL"; fi
sleep 2
[ -n "${EIRA_CI_NO_POWEROFF:-}" ] || systemctl poweroff
