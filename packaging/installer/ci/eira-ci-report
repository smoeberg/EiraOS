seal_owner_handover() {
    key=$(/usr/bin/eira-audit-seal show | grep -E '^[0-9a-f]+(-[0-9a-f]+)*/[0-9a-f]+-[0-9a-f]+$') || return 1
    [ -n "$key" ] && [ ! -e /var/lib/eira-audit-seal/verify-key ] || return 1
    # No forced rotation here: rotating twice within one sealing interval
    # makes journald write two tags with the same epoch, which
    # journalctl --verify reports as corruption (seen in this VM).
    # The online system.journal is appended to while it is read; a hash
    # entry can point at an object not yet written ("Invalid data object",
    # seen in this VM while the archived files passed). Sync and retry; a
    # real seal break fails every attempt.
    ok=
    for attempt in 1 2 3; do
        journalctl --sync >/dev/null 2>&1 || true
        if journalctl --system --verify --verify-key="$key" >/tmp/seal-verify.txt 2>&1; then
            ok=1; break
        fi
        sleep 3
    done
    if [ -z "$ok" ]; then
        say "diag seal-verify: $(tr '\n' ' ' </tmp/seal-verify.txt | cut -c1-1500)"
        return 1
    fi
    /usr/bin/eira-audit-verify --journal --verify-key "$key" >/tmp/seal-audit.txt 2>&1 || {
        say "diag seal-audit-verify: $(tr '\n' ' ' </tmp/seal-audit.txt | cut -c1-800)"
        return 1
    }
}
