#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CARGO_CRATE=eira-spatial-desktop

%:
	dh $@ --with python3

override_dh_auto_build:
	npm ci --prefix ui --ignore-scripts
	npm run build --prefix ui
	cd ui && npm run tauri -- build --no-bundle
	# EIRA-CONSENT-AGENT: the only process the gate takes decisions from.
	cargo build --release -p eira-consent-agent

# Debian's nocheck skips the suites (CI runs them in a parallel job on 26.04).
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	python3 -m venv debian/.test-venv
	debian/.test-venv/bin/python -m pip install -r requirements-dev.txt
	PYTHONPATH=. debian/.test-venv/bin/python -m pytest -q tests
	npm test --prefix ui
else
	@echo "nocheck: the test suites run in CI (tests-on-ubuntu-26-04)"
endif

override_dh_auto_install:
	install -d debian/eira-os-core/usr/lib/eira-os
	# Only the production import closure of app/, never the dev HTTP bridge,
	# its routers or prototype daemons (scripts/app_modules.py).
	python3 scripts/app_modules.py > debian/app-modules.closure
	grep -v '^#' packaging/app-modules.txt | diff -u - debian/app-modules.closure
	grep -v '^#' packaging/app-modules.txt | while read -r f; do \
		install -D -m 0644 "$$f" "debian/eira-os-core/usr/lib/eira-os/$$f" || exit 1; \
	done
	install -m 0644 requirements.txt debian/eira-os-core/usr/lib/eira-os/
	install -d debian/eira-os-core/usr/share/eira-os
	install -m 0644 packaging/daemon-policy.json debian/eira-os-core/usr/share/eira-os/daemon-policy.json
	install -d debian/eira-os-core/usr/bin
	for daemon in $$(python3 -c 'import json; from pathlib import Path; print(" ".join(json.loads(Path("packaging/daemon-policy.json").read_text())["production_daemons"]))'); do \
		install -m 0755 packaging/bin/eira-daemon \
			debian/eira-os-core/usr/bin/eira-$$daemon; \
	done
	install -m 0755 packaging/bin/eira-rights-apply \
		debian/eira-os-core/usr/bin/eira-rights-apply
	# Signed default rights set; the one-time build key is never written.
	python3 scripts/build_default_rights.py debian/eira-os-core/usr/lib/eira-os/rights
	install -m 0755 ui/src-tauri/target/release/eira-spatial-desktop \
		debian/eira-os-core/usr/bin/eira-spatial-desktop
	install -m 0755 packaging/session/eira-session \
		debian/eira-os-core/usr/bin/eira-session
	install -d debian/eira-os-core/usr/share/wayland-sessions
	install -m 0644 packaging/session/eira-session.desktop \
		debian/eira-os-core/usr/share/wayland-sessions/eira-session.desktop
	install -d debian/eira-os-core/usr/share/eira-os/labwc
	install -m 0644 packaging/session/config/labwc/rc.xml \
		debian/eira-os-core/usr/share/eira-os/labwc/rc.xml
	install -m 0755 packaging/session/config/labwc/autostart \
		debian/eira-os-core/usr/share/eira-os/labwc/autostart
	install -d debian/eira-os-core/usr/lib/systemd/system
	install -m 0644 systemd/eira-*.service systemd/eira.target \
		debian/eira-os-core/usr/lib/systemd/system/
	install -D -m 0755 packaging/session/eira-session-policy \
		debian/eira-os-core/usr/lib/eira/eira-session-policy
	install -m 0644 packaging/session/eira-session-policy.service \
		debian/eira-os-core/usr/lib/systemd/system/eira-session-policy.service
	install -D -m 0644 packaging/polkit/50-eira-power.rules \
		debian/eira-os-core/usr/share/polkit-1/rules.d/50-eira-power.rules
	install -d debian/eira-os-core/etc/apparmor.d
	install -m 0644 packaging/apparmor/usr.bin.eira-* \
		debian/eira-os-core/etc/apparmor.d/
	# Rights sync with Fleet (oneshot + timer) and enrollment (FLEET-RIGHTS-API §7-8).
	install -m 0644 packaging/rights/eira-rights-sync.service packaging/rights/eira-rights-sync.timer \
		debian/eira-os-core/usr/lib/systemd/system/
	install -m 0644 packaging/rights/usr.bin.eira-rights-apply \
		debian/eira-os-core/etc/apparmor.d/usr.bin.eira-rights-apply
	install -m 0755 packaging/bin/eira-enroll debian/eira-os-core/usr/bin/eira-enroll
	install -m 0755 packaging/bin/eira-audit-verify debian/eira-os-core/usr/bin/eira-audit-verify
	# The model process (GATE-KERNEL bilag A): its own user, no network, no /data.
	install -m 0755 packaging/bin/eira-modeld debian/eira-os-core/usr/bin/eira-modeld
	install -m 0644 packaging/model/eira-modeld.service debian/eira-os-core/usr/lib/systemd/system/
	install -m 0644 packaging/model/usr.bin.eira-modeld debian/eira-os-core/etc/apparmor.d/usr.bin.eira-modeld
	# The consent agent; postinst makes it root:eira-consent 2755 (dpkg-statoverride).
	install -m 0755 target/release/eira-consent-agent debian/eira-os-core/usr/lib/eira-os/eira-consent-agent
	install -m 0644 packaging/consent/usr.lib.eira-os.eira-consent-agent \
		debian/eira-os-core/etc/apparmor.d/usr.lib.eira-os.eira-consent-agent
	# The journal's Forward Secure Sealing, set up once at first boot.
	install -m 0755 packaging/bin/eira-audit-seal debian/eira-os-core/usr/bin/eira-audit-seal
	install -m 0644 packaging/audit/eira-audit-seal.service debian/eira-os-core/usr/lib/systemd/system/

override_dh_installsystemd:
	dh_installsystemd --no-start
