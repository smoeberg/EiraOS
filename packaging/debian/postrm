#!/bin/sh
set -eu

# Give the system back its own login sessions when EiraOS is removed.
case "${1:-}" in
    remove|purge)
        hidden=/var/lib/eira/hidden-sessions
        if [ -d "$hidden" ]; then
            for stored in "$hidden"/*; do
                [ -e "$stored" ] || continue
                base=$(basename "$stored")
                dir=${base%%--*}
                name=${base#*--}
                dpkg-divert --local --rename --divert "$stored" \
                    --remove "/usr/share/$dir/$name" || true
            done
        fi
        ;;
esac
if [ "${1:-}" = purge ] && dpkg-statoverride --list /usr/lib/eira-os/eira-consent-agent >/dev/null 2>&1; then
    dpkg-statoverride --remove /usr/lib/eira-os/eira-consent-agent || true
fi

#DEBHELPER#

exit 0
