#include <tunables/global>

/usr/bin/eira-delegationd flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/python>

  /usr/bin/eira-delegationd rix,
  /bin/dash ix,
  /usr/bin/dash ix,
  /usr/bin/python3{,.[0-9]*} mrix,
  /usr/lib/eira-os/ r,
  /usr/lib/eira-os/** r,
  /etc/eira/eira.conf r,

  /run/eira/ rw,
  # F1c.3: its own socket, and only the sockets of the daemons it calls.
  /run/eira/delegationd.sock rwk,
  /run/eira/stated.sock rw,
  /run/eira/consent-keys.db rk,
  # app/consent_keys.py: the store must be on tmpfs and keys are tied to the boot.
  @{PROC}/@{pid}/mounts r,
  @{PROC}/sys/kernel/random/boot_id r,
  /data/eira-app.db rwk,
  /data/eira-app.db-{journal,shm,wal} rwk,

  network unix stream,
  deny network inet,
  deny network inet6,
  deny @{HOME}/** rwklx,
}
