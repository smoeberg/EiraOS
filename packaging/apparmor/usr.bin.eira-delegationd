#include <tunables/global>

/usr/bin/python3 {
  #include <abstractions/base>
  #include <abstractions/python>

  # Required for EiraOS delegation daemon
  /usr/lib/eira-os/** r,
  /usr/lib/eira-os/ r,

  # Socket access
  /run/eira/ r,
  /run/eira/** rw,
  /run/eira/delegationd.sock rw,

  # Database access
  /data/eira.db r,
  /data/eira.db-wal r,
  /data/eira.db-shm r,
  /data/eira-delegation.key r,

  # State directory
  /data/ r,
  /data/** r,

  # Logs
  /var/log/eira/ r,
  /var/log/eira/** rw,

  # Deny everything else
  DENY /** rwklx,
  DENY /etc/** r,
  DENY /usr/lib/** rwklx,
  DENY /usr/bin/** rwklx,
}
