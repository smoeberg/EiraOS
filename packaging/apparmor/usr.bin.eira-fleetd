#include <tunables/global>

/usr/bin/eira-fleetd flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  #include <abstractions/python>

  /usr/bin/eira-fleetd rix,
  /bin/dash ix,
  /usr/bin/dash ix,
  /usr/bin/python3{,.[0-9]*} mrix,
  /usr/lib/eira-os/ r,
  /usr/lib/eira-os/** r,
  /etc/eira/eira.conf r,

  /run/eira/ rw,
  # F1c.3: its own socket, and only the sockets of the daemons it calls.
  /run/eira/fleetd.sock rwk,
  /run/eira/stated.sock rw,
  /data/eira-fleet/ rw,
  /data/eira-fleet/** rwk,

  network unix stream,
  network inet stream,
  network inet6 stream,
  deny @{HOME}/** rwklx,
}
