#include <tunables/global>

/usr/bin/eira-stated flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/python>

  /usr/bin/eira-stated rix,
  /bin/dash ix,
  /usr/bin/dash ix,
  /usr/bin/python3{,.[0-9]*} mrix,
  /usr/lib/eira-os/ r,
  /usr/lib/eira-os/** r,
  /etc/eira/eira.conf r,

  /run/eira/ rw,
  # F1c.3: its own socket, and only the sockets of the daemons it calls.
  /run/eira/stated.sock rwk,
  # app/ipc/access.py: which daemon a daemon_write caller is, if it has no
  # AppArmor label (its systemd unit's cgroup).
  @{PROC}/[0-9]*/cgroup r,
  /data/eira.db rwk,
  /data/eira.db-{journal,shm,wal} rwk,

  network unix stream,
  deny network inet,
  deny network inet6,
  deny @{HOME}/** rwklx,
}
