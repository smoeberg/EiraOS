#include <tunables/global>

/usr/bin/eira-graphd flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/python>

  /usr/bin/eira-graphd rix,
  /bin/dash ix,
  /usr/bin/dash ix,
  /usr/bin/python3{,.[0-9]*} mrix,
  /usr/lib/eira-os/ r,
  /usr/lib/eira-os/** r,
  /etc/eira/eira.conf r,

  /run/eira/ rw,
  # F1c.3: its own socket, and only the sockets of the daemons it calls.
  /run/eira/graphd.sock rwk,
  /run/eira/stated.sock rw,
  /data/eira-app.db r,
  /data/eira-app.db-{shm,wal} r,

  network unix stream,
  deny network inet,
  deny network inet6,
  deny @{HOME}/** rwklx,
}
