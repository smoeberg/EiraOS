#include <tunables/global>

/usr/bin/eira-identityd flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/ssl_certs>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  #include <abstractions/python>

  /usr/bin/eira-identityd rix,
  /bin/dash ix,
  /usr/bin/dash ix,
  /usr/bin/python3{,.[0-9]*} mrix,
  /usr/lib/eira-os/ r,
  /usr/lib/eira-os/** r,
  /etc/eira/eira.conf r,
  /etc/eira/providers.json r,
  /etc/eira/trust/ r,
  /etc/eira/trust/** r,

  # Sessions (shared with the gate) and OIDC login state.
  /data/ r,
  /data/eira-app.db rwk,
  /data/eira-app.db-{journal,shm,wal} rwk,
  # Login: the caller's loginuid, cross-checked with SO_PEERCRED.
  @{PROC}/[0-9]*/loginuid r,
  /run/eira/ rw,
  /run/eira/*.sock rwk,
  /run/eira/consent-keys.db rwk,
  # app/consent_keys.py: the store must be on tmpfs and keys are tied to the boot.
  @{PROC}/@{pid}/mounts r,
  @{PROC}/sys/kernel/random/boot_id r,
  /var/log/eira/ rw,
  /var/log/eira/** rw,

  network unix stream,
  network inet stream,
  network inet6 stream,
  deny @{HOME}/** rwklx,
}
