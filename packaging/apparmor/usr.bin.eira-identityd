#include <tunables/global>

/usr/bin/eira-identityd flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/ssl_certs>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  #include <abstractions/python>

  /usr/bin/eira-identityd rix,
  /bin/dash ix,
  /usr/bin/dash ix,
  /usr/bin/python3{,.[0-9]*} mrix,
  /usr/lib/eira-os/ r,
  /usr/lib/eira-os/** r,
  /etc/eira/eira.conf r,
  /etc/eira/providers.json r,
  /etc/eira/trust/ r,
  /etc/eira/trust/** r,

  # Sessions (shared with the gate) and OIDC login state.
  /data/ r,
  /data/eira-app.db rwk,
  /data/eira-app.db-{journal,shm,wal} rwk,
  # Login: the caller's loginuid, cross-checked with SO_PEERCRED.
  @{PROC}/[0-9]*/loginuid r,
  # Login and the consent agent (EIRA-CONSENT-AGENT §5.3): the caller's
  # logind session, and the agent's compositor checked in /proc (owner,
  # parent chain, start time). app/auth/consent_agent.py reads exactly these.
  @{PROC}/[0-9]*/sessionid r,
  @{PROC}/[0-9]*/stat r,
  @{PROC}/[0-9]*/status r,
  /run/systemd/sessions/ r,
  /run/systemd/sessions/* r,
  /run/eira/ rw,
  # F1c.3: its own socket, and only the sockets of the daemons it calls.
  /run/eira/identityd.sock rwk,
  # app/ipc/access.py: which daemon a daemon_write caller is, if it has no
  # AppArmor label (its systemd unit's cgroup).
  @{PROC}/[0-9]*/cgroup r,
  /run/eira/stated.sock rw,
  /run/eira/consent-keys.db rwk,
  # app/consent_keys.py: the store must be on tmpfs and keys are tied to the boot.
  @{PROC}/@{pid}/mounts r,
  @{PROC}/sys/kernel/random/boot_id r,

  network unix stream,
  network inet stream,
  network inet6 stream,
  deny @{HOME}/** rwklx,
}
