#include <tunables/global>

# EIRA-CONSENT-AGENT: setgid eira-consent, runs as the user. It talks to its
# compositor and three daemons, reads one config line, and listens on one
# socket. No network, no home directory, nothing else.
/usr/lib/eira-os/eira-consent-agent flags=(attach_disconnected) {
  #include <abstractions/base>

  /usr/lib/eira-os/eira-consent-agent mr,
  /etc/eira/eira.conf r,

  # Its compositor and its own socket in the user's runtime directory.
  owner /run/user/[0-9]*/ r,
  owner /run/user/[0-9]*/wayland-[0-9]* rw,
  owner /run/user/[0-9]*/eira-consent.sock rwk,
  # Shared memory for the window's buffers (memfd).
  owner /memfd:* rw,
  owner /dev/shm/** rw,

  # identityd (registration, key), the gate, delegationd. Nothing else.
  /run/eira/identityd.sock rw,
  /run/eira/intentd.sock rw,
  /run/eira/delegationd.sock rw,
  deny /run/eira/{stated,fleetd,veritasd,graphd}.sock rw,

  @{PROC}/sys/kernel/random/boot_id r,
  owner @{PROC}/@{pid}/fd/ r,

  network unix stream,
  deny network inet,
  deny network inet6,
  deny @{HOME}/** rwklx,
  deny /data/** rwklx,
}
