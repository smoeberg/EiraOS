#include <tunables/global>

# eira-rights-apply as run by eira-rights-sync.service (sync with Fleet).
# As ExecStartPre of eira-intentd it runs under eira-intentd's profile (rix).
/usr/bin/eira-rights-apply flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/python>
  #include <abstractions/openssl>
  #include <abstractions/ssl_certs>

  /usr/bin/eira-rights-apply rix,
  /bin/dash ix,
  /usr/bin/dash ix,
  /usr/bin/python3* ix,

  /usr/lib/eira-os/ r,
  /usr/lib/eira-os/** r,
  @{PROC}/sys/kernel/random/boot_id r,

  /etc/eira/eira.conf r,
  /etc/eira/enrollment.json r,
  /etc/eira/fleet/ r,
  /etc/eira/fleet/ca.pem r,
  /etc/eira/fleet/device.crt r,
  /etc/eira/fleet/device.key r,
  /etc/eira/fleet/tenant.token r,

  # The device key lives in the TPM (EIRA-CONTEXT §5.0): OpenSSL's tpm2
  # provider and the TPM resource manager, nothing else of the TPM.
  /usr/share/eira-os/openssl-tpm2.cnf r,
  /usr/lib/@{multiarch}/ossl-modules/tpm2.so mr,
  /usr/lib/@{multiarch}/libtss2-*.so* mr,
  /dev/tpmrm0 rw,

  /data/ r,
  /data/audit/anchor.json r,
  /data/rights/ rw,
  /data/rights/** rwk,
  # The journal's FSS verification key, until handed to Fleet (audit_seal.py).
  /etc/machine-id r,
  /var/lib/eira-audit-seal/ rw,
  /var/lib/eira-audit-seal/** rw,

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  deny /home/** rwklx,
  deny /root/** rwklx,
}
