#!/bin/sh
# EiraOS session launcher (Sprint 1)
# Boot-kæde: greetd (autologin) -> eira-session -> labwc -> eira-shell (Tauri)
#
# EiraOS viser ingen skrivebord, ingen startmenu: labwc starter fullscreen
# eira-shell via labwc autostart. Builder Mode kræver labwc panel (P4).
set -eu

if [ -r /etc/eira/eira.conf ]; then
    set -a
    . /etc/eira/eira.conf
    set +a
fi

EIRA_RUN_DIR=${EIRA_RUN_DIR:-/run/eira}
export EIRA_RUN_DIR

# WM-valg: labwc (standard, Builder-toggle muligt) eller cage (single-app).
WM=${EIRA_SESSION_WM:-labwc}
SHELL_BIN=${EIRA_SHELL_BIN:-/usr/bin/eira-spatial-desktop}

if [ "$(id -u)" = "0" ]; then
    echo "eira-session: afviser at køre som root" >&2
    exit 77
fi

mkdir -p "$EIRA_RUN_DIR" 2>/dev/null || true
chmod 770 "$EIRA_RUN_DIR" 2>/dev/null || true

case "$WM" in
    labwc|cage) ;;
    *)
        echo "eira-session: ukendt WM '$WM' (forventet labwc|cage)" >&2
        exit 78
        ;;
esac

if ! command -v "$WM" >/dev/null 2>&1; then
    echo "eira-session: $WM er ikke installeret (apt install $WM)" >&2
    exit 78
fi

if [ ! -x "$SHELL_BIN" ]; then
    echo "eira-session: eira-shell ($SHELL_BIN) mangler - session afsluttes" >&2
    exit 79
fi

# labwc autostart (packaging/session/config/labwc/autostart) starter eira-shell;
# cage kører shell direkte som eneste klient.
if [ "$WM" = "cage" ]; then
    exec cage -- "$SHELL_BIN"
fi

exec labwc
