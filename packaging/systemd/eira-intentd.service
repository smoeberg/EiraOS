[Unit]
Description=EiraOS Core Daemon - intentd (Ubuntu 24.04 LTS)
After=network.target systemd-user-sessions.service
Documentation=https://github.com/smoeberg/EiraOS

[Service]
Type=simple
User=eira
Group=eira
ExecStart=/usr/bin/python3 /opt/eiraos/app/daemons/intentd.py
Restart=always
RestartSec=3
RuntimeDirectory=eira
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
