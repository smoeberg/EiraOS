[Unit]
Description=EiraOS Wayland session (labwc + greetd autologin)
Documentation=https://github.com/smoeberg/EiraOS
Wants=eira.target
After=eira.target graphical.target
ConditionUser=!root

[Service]
Type=simple
User=ubuntu
Group=eira
EnvironmentFile=-/etc/eira/eira.conf
ExecStart=/usr/bin/eira-session
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/eira
PrivateTmp=true

[Install]
WantedBy=graphical.target
