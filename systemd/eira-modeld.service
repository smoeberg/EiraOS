[Unit]
Description=EiraOS Model Gateway Daemon
After=eira-stated.service eira-identityd.service eira-veritasd.service
Requires=eira-stated.service

[Service]
Type=simple
User=eira
Group=eira
ExecStart=/usr/bin/python3 -m app.daemons.runner --daemon modeld
Restart=on-failure
RestartSec=5

# Security hardening
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

# Resource limits
LimitNOFILE=1024
LimitNPROC=256
MemoryLimit=1G
CPUQuota=100%

# Environment
Environment=EIRA_RUN_DIR=/run/eira
Environment=EIRA_STATE_DB=/data/eira.db

[Install]
WantedBy=eira.target
