[Unit]
Description=EiraOS Fleet IPC daemon
Documentation=https://github.com/smoeberg/EiraOS
PartOf=eira.target
Before=eira.target
Requires=eira-stated.service
After=eira-stated.service
# A crash loop stops after 10 starts in two minutes and shows as failed
# (UDVIKLINGSPLAN F1c.13). systemd's default, 5 in 10 s, is never reached
# at RestartSec=2s, so a crash loop ran for ever.
StartLimitIntervalSec=120s
StartLimitBurst=10

[Service]
Type=simple
User=eira
Group=eira
# May hand its socket to the client group (not a data group).
SupplementaryGroups=eira-clients
WorkingDirectory=/usr/lib/eira-os
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/usr/lib/eira-os
# The WebSocket listener is off until a client exists and is described
# (UDVIKLINGSPLAN F1c.6, vurderingen G-10). fleetd talks only over its Unix
# socket; the address families and IP rules below keep it that way even if
# eira.conf turns the listener on (then fleetd fails to start).
Environment=EIRA_FLEET_WS_ENABLED=0
Environment=EIRA_FLEET_KEY_DIR=/data/eira-fleet
Environment=EIRA_APP_DB=/data/eira-fleet/inventory.db
EnvironmentFile=-/etc/eira/eira.conf
ExecStart=/usr/bin/eira-fleetd
Restart=always
RestartSec=2s
# Idle it uses 20 to 46 MB and 2 to 5 threads; one thread per connection.
# At the limits it is killed and restarted (memory) or refuses the
# connection (threads), instead of taking the machine with it.
MemoryMax=512M
TasksMax=128
RuntimeDirectory=eira
RuntimeDirectoryMode=0751
RuntimeDirectoryPreserve=yes
StateDirectory=eira
StateDirectoryMode=0770
UMask=0117
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictSUIDSGID=true
ReadWritePaths=/data/eira-fleet /run/eira
AppArmorProfile=/usr/bin/eira-fleetd

[Install]
WantedBy=eira.target
