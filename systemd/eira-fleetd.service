[Unit]
Description=EiraOS Fleet IPC daemon
Documentation=https://github.com/smoeberg/EiraOS
PartOf=eira.target
Before=eira.target

[Service]
Type=simple
User=eira
Group=eira
WorkingDirectory=/opt/eira
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/eira
Environment=EIRA_FLEET_WS_ENABLED=1
Environment=EIRA_FLEET_WS_HOST=127.0.0.1
Environment=EIRA_FLEET_WS_PORT=8765
ExecStart=/usr/bin/python3 -m app.daemons.runner --daemon fleetd --socket-dir /run/eira
Restart=always
RestartSec=2s
RuntimeDirectory=eira
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
StateDirectory=eira
StateDirectoryMode=0770
LogsDirectory=eira
LogsDirectoryMode=0770
UMask=0117
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
ReadWritePaths=/opt/eira/data

[Install]
WantedBy=eira.target
