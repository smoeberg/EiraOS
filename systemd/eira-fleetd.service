[Unit]
Description=EiraOS Fleet IPC daemon (fleetd)
Documentation=https://github.com/smoeberg/EiraOS
PartOf=eira.target
Before=eira.target
Requires=eira-stated.service
After=eira-stated.service

[Service]
Type=simple
User=eira
Group=eira
WorkingDirectory=/usr/lib/eira-os
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/usr/lib/eira-os
Environment=EIRA_RUN_DIR=/run/eira
EnvironmentFile=-/etc/eira/eira.conf
ExecStart=/usr/bin/python3 -m app.daemons.runner --daemon fleetd --socket-dir /run/eira
Restart=always
RestartSec=2s
RuntimeDirectory=eira
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
UMask=0117
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/eira /var/lib/eira /var/log/eira /data

[Install]
WantedBy=eira.target
