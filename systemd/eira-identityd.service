[Unit]
Description=EiraOS Identity IPC daemon
Documentation=https://github.com/smoeberg/EiraOS
PartOf=eira.target
Before=eira.target
Requires=eira-stated.service
After=eira-stated.service

[Service]
Type=simple
User=eira
Group=eira
# May hand its socket to the client group (not a data group).
SupplementaryGroups=eira-clients
WorkingDirectory=/usr/lib/eira-os
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/usr/lib/eira-os
EnvironmentFile=-/etc/eira/eira.conf
# Sessions live in the app database shared with the gate (intentd).
Environment=EIRA_APP_DB=/data/eira-app.db
ExecStart=/usr/bin/eira-identityd
Restart=always
RestartSec=2s
RuntimeDirectory=eira
RuntimeDirectoryMode=0751
RuntimeDirectoryPreserve=yes
StateDirectory=eira
StateDirectoryMode=0770
LogsDirectory=eira
LogsDirectoryMode=0770
UMask=0117
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
ReadWritePaths=/data /run/eira /var/log/eira
AppArmorProfile=/usr/bin/eira-identityd

[Install]
WantedBy=eira.target
