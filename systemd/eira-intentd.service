[Unit]
Description=EiraOS Intent IPC daemon
Documentation=https://github.com/smoeberg/EiraOS
PartOf=eira.target
Before=eira.target
Requires=eira-stated.service
After=eira-stated.service
# A crash loop stops after 10 starts in two minutes and shows as failed
# (UDVIKLINGSPLAN F1c.13). systemd's default, 5 in 10 s, is never reached
# at RestartSec=2s, so a crash loop ran for ever.
StartLimitIntervalSec=120s
StartLimitBurst=10

[Service]
# notify: started means the gate serves (READY=1 after its socket is bound),
# so units ordered after it wait for that. WatchdogSec: the runner pings only
# while the gate answers its own health call; a gate that hangs is killed and
# restarted (Restart=always). SIGKILL, not SIGABRT: no core dump of a
# process that holds sessions.
Type=notify
NotifyAccess=main
WatchdogSec=30s
WatchdogSignal=SIGKILL
User=eira
Group=eira
# May hand its socket to the client group (not a data group).
SupplementaryGroups=eira-clients
WorkingDirectory=/usr/lib/eira-os
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/usr/lib/eira-os
Environment=EIRA_APP_DB=/data/eira-app.db
# The audit chain has its own database; only intentd's profile writes it.
Environment=EIRA_GATE_AUDIT_DB=/data/eira-gate-audit.db
Environment=EIRA_CONSENT_KEY_DB=/run/eira/consent-keys.db
# Rights cache (EIRA-RIGHTS-SET-1.0): written by the governance agent, read by the gate.
Environment=EIRA_RIGHTS_DIR=/data/rights
EnvironmentFile=-/etc/eira/eira.conf
# Apply the bundle's signed default set before the gate starts. '-': a
# rejected or missing set must not stop the gate; it then has no rights
# (fails closed) and gate.capabilities says why.
Environment=EIRA_RIGHTS_BUNDLE_DIR=/usr/lib/eira-os/rights
ExecStartPre=-/usr/bin/eira-rights-apply apply-default
ExecStart=/usr/bin/eira-intentd
Restart=always
RestartSec=2s
# Idle it uses 20 to 46 MB and 2 to 5 threads; one thread per connection.
# At the limits it is killed and restarted (memory) or refuses the
# connection (threads), instead of taking the machine with it.
MemoryMax=512M
TasksMax=128
RuntimeDirectory=eira
RuntimeDirectoryMode=0751
RuntimeDirectoryPreserve=yes
StateDirectory=eira
StateDirectoryMode=0770
UMask=0117
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
ReadWritePaths=/data /run/eira
AppArmorProfile=/usr/bin/eira-intentd

[Install]
WantedBy=eira.target
