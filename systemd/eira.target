[Unit]
Description=EiraOS core IPC daemons
Documentation=https://github.com/smoeberg/EiraOS
Requires=eira-stated.service
Wants=eira-identityd.service eira-fleetd.service eira-veritasd.service eira-intentd.service eira-graphd.service
After=eira-stated.service eira-identityd.service eira-fleetd.service eira-veritasd.service eira-intentd.service eira-graphd.service

[Install]
WantedBy=multi-user.target
