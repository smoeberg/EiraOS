[Unit]
Description=EiraOS Delegation IPC daemon
PartOf=eira.target
After=eira-stated.service
Requires=eira-stated.service
[Service]
Type=simple
User=eira
Group=eira
SupplementaryGroups=eira-clients
WorkingDirectory=/usr/lib/eira-os
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/usr/lib/eira-os
Environment=EIRA_APP_DB=/data/eira-app.db
EnvironmentFile=-/etc/eira/eira.conf
ExecStart=/usr/bin/eira-delegationd
Restart=always
RestartSec=2s
RuntimeDirectory=eira
RuntimeDirectoryMode=0751
StateDirectory=eira
StateDirectoryMode=0770
LogsDirectory=eira
LogsDirectoryMode=0770
UMask=0117
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
ReadWritePaths=/data /run/eira /var/log/eira
AppArmorProfile=/usr/bin/eira-delegationd
[Install]
WantedBy=eira.target
