[Unit]
Description=EiraOS Graph IPC daemon
Documentation=https://github.com/smoeberg/EiraOS
PartOf=eira.target
Before=eira.target
Requires=eira-stated.service
After=eira-stated.service

[Service]
Type=simple
User=eira
Group=eira
WorkingDirectory=/usr/lib/eira-os
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/usr/lib/eira-os
Environment=EIRA_APP_DB=/data/eira-app.db
EnvironmentFile=-/etc/eira/eira.conf
ExecStart=/usr/bin/eira-graphd
Restart=always
RestartSec=2s
RuntimeDirectory=eira
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
StateDirectory=eira
StateDirectoryMode=0770
LogsDirectory=eira
LogsDirectoryMode=0770
UMask=0117
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
ReadOnlyPaths=-/data/eira-app.db -/data/eira-app.db-shm -/data/eira-app.db-wal
ReadWritePaths=/run/eira /var/log/eira
AppArmorProfile=/usr/bin/eira-graphd

[Install]
WantedBy=eira.target
